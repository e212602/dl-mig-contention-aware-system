apiVersion: v1
kind: Pod
metadata:
  name: {{ controller_pod_name }}
  labels:
    app.kubernetes.io/part-of: vllm-pcie-sweep
spec:
  restartPolicy: Never
  containers:
    - name: controller
      image: e8113/controller:latest
      imagePullPolicy: Never
{% if scheduler_policy | default('') | length > 0 %}
      args:
        - "--policy"
        - "{{ scheduler_policy }}"
{% endif %}
      env:
        - name: GB_RATE
          value: "{{ gb_rate }}"
        - name: WORKER_IDS
          value: "{{ rate_control_worker_id }}"
        - name: READY_FILE
          value: "/tmp/rate-control/{{ ready_file_name }}"
        # Limiter stays off (boot phase) until this file exists.
        - name: GO_FILE
          value: "/tmp/rate-control/{{ go_file_name }}"
        - name: BURST_TICKS
          value: "{{ burst_ticks }}"
        - name: SCHEDULER_LOG
          value: "/tmp/results/{{ iter_rel }}/scheduler.csv"
{% if scheduler_policy | default('') | length > 0 %}
        - name: BW_ALLOC_FILE
          value: "/tmp/rate-control/static_ilp.yaml"
{% endif %}
      resources:
        limits:
          cpu: "2"
          memory: 2Gi
      volumeMounts:
        - mountPath: /tmp/rate-control
          name: rate-control
          readOnly: false
        - mountPath: /tmp/results
          name: results
          readOnly: false
{% if scheduler_policy | default('') | length > 0 %}
        - mountPath: /tmp/rate-control/static_ilp.yaml
          name: static-ilp
          readOnly: true
{% endif %}
  volumes:
    - name: rate-control
      hostPath:
        path: {{ rate_control_dir }}
        type: DirectoryOrCreate
    - name: results
      hostPath:
        path: {{ results_root }}
        type: DirectoryOrCreate
{% if scheduler_policy | default('') | length > 0 %}
    - name: static-ilp
      hostPath:
        path: {{ rate_control_dir }}/static_ilp.yaml
        type: File
{% endif %}
